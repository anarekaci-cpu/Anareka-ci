/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-ar150DoAojai1PELbj0zka9cdLwTL+UZ5Plv6XBMj2o=' 'sha256-SGK2cRa5DmMzFzLl5CTHEPKyWWEgfKS5ZlIGbEuni8s=' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https:; frame-src https://www.youtube-nocookie.com https://www.youtube.com; connect-src 'self' https://formspree.io https://cloudflareinsights.com; form-action 'self' https://formspree.io; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; upgrade-insecure-requests

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/emoji/*
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=300, must-revalidate

/*.js
  Cache-Control: public, max-age=300, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/.well-known/*
  Content-Type: text/plain; charset=utf-8

/site.webmanifest
  Cache-Control: public, max-age=86400

# Fichiers du dépôt servis tels quels mais sans intérêt pour la recherche.
/.github/*
  X-Robots-Tag: noindex, nofollow

/templates/*
  X-Robots-Tag: noindex, nofollow

/tests/*
  X-Robots-Tag: noindex, nofollow

/assets/marque/*
  X-Robots-Tag: noindex, nofollow

/CLAUDE.md
  X-Robots-Tag: noindex, nofollow

/CHANGELOG.md
  X-Robots-Tag: noindex, nofollow

/package.json
  X-Robots-Tag: noindex, nofollow

/package-lock.json
  X-Robots-Tag: noindex, nofollow
